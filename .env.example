# ==============================================================================
# TwitSticker Pro — Firebase Auth + Paystack Checkout Environment Variables
# ==============================================================================

# 1. Firebase Web SDK (from Firebase Console -> Project Settings -> Web App)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_WEB_AUTH_DOMAIN=app-92db9b7e.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=app-92db9b7e
FIREBASE_WEB_APP_ID=1:753358605856:web:your_web_app_id

# 2. Firebase Admin SDK (raw single-line JSON or base64-encoded JSON)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# 3. Paystack Checkout & Subscriptions (Paystack Dashboard -> Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_live_or_sk_test_your_secret_key
# Currency enabled on your Paystack account (USD, KES, NGN, GHS, ZAR):
PAYSTACK_CURRENCY=USD
# Amounts in smallest unit (e.g. cents for USD: 149 = $1.49, 600 = $6, 1000 = $10):
PAYSTACK_AMOUNT_MONTHLY=149
PAYSTACK_AMOUNT_6MONTHS=600
PAYSTACK_AMOUNT_YEARLY=1000
# Optional recurring Paystack Plan Codes (from Paystack Dashboard -> Plans):
# PAYSTACK_PLAN_MONTHLY=PLN_...
# PAYSTACK_PLAN_6MONTHS=PLN_...
# PAYSTACK_PLAN_YEARLY=PLN_...

# Public base URL for Paystack callback redirects
APP_BASE_URL=https://gifsticker.site

# Daily free sticker limit (default: 4)
FREE_DAILY_LIMIT=4
